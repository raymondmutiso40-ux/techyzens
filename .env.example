# Application
APP_NAME="BidDesk AI - Autonomous Bid Intelligence System"
APP_VERSION="1.0.0"
DEBUG=false

# Cloud deployment (set these as Railway service variables)
FRONTEND_URL="https://your-project.vercel.app"
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Supabase private Storage bucket (never expose the service role key to the frontend)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="tenderpilot-documents"

# Database Configuration
# Local Standalone SQLite (Default zero-config):
DATABASE_URL="sqlite+aiosqlite:///./storage/bid_desk.db"
SYNC_DATABASE_URL="sqlite:///./storage/bid_desk.db"

# Supabase PostgreSQL: copy the Session pooler connection string from Supabase > Connect.
# Use the postgresql+asyncpg:// scheme for this async SQLAlchemy backend.
# DATABASE_URL="postgresql+asyncpg://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres"

# Slide 8 - Spend Caps & Safety Limits
DAILY_SPEND_CAP_USD=50.00
PER_TENDER_SPEND_CAP_USD=5.00
SPEND_WARNING_THRESHOLD_PCT=80.0

# Slide 2 & 3 - Scoring & Review Lead
FIT_THRESHOLD_SCORE=70
DEFAULT_BID_LEAD_EMAIL="bid.lead@acme-consulting.org"

# Thrivewave SMS Alerts Configuration
ENABLE_SMS_ALERTS=true
THRIVEWAVE_API_KEY=""
THRIVEWAVE_SENDER_ID="BIDDESK"
THRIVEWAVE_API_URL="https://api.thrivewave.com/v1/sms/send"
BID_LEAD_PHONE="+1234567890"

# AI Reasoning Engine (Choose: mock | claude | gemini | openai | otari)
LLM_PROVIDER="mock"
ANTHROPIC_API_KEY=""
CLAUDE_MODEL="claude-3-5-sonnet-20241022"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-pro"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"

# Otari.ai gateway (OpenAI-compatible; choose an exact model ID from your Otari model list)
OTARI_API_KEY=""
OTARI_BASE_URL="https://api.otari.ai/api"
OTARI_MODEL=""

# Email Delivery (Choose: mock | resend | smtp)
EMAIL_PROVIDER="mock"
RESEND_API_KEY=""
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""

# API Security
ADMIN_API_KEY="biddesk-secret-key-2026"
