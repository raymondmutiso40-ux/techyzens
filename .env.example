# Application
APP_NAME="BidDesk AI - Autonomous Bid Intelligence System"
APP_VERSION="1.0.0"
DEBUG=false

# Database Configuration
# Local Standalone SQLite (Default zero-config):
DATABASE_URL="sqlite+aiosqlite:///./storage/bid_desk.db"
SYNC_DATABASE_URL="sqlite:///./storage/bid_desk.db"

# Rumptycloud / Managed PostgreSQL:
# DATABASE_URL="postgresql+asyncpg://<username>:<password>@<rumptycloud-host>:5432/<database_name>"
# SYNC_DATABASE_URL="postgresql://<username>:<password>@<rumptycloud-host>:5432/<database_name>"

# Slide 8 - Spend Caps & Safety Limits
DAILY_SPEND_CAP_USD=50.00
PER_TENDER_SPEND_CAP_USD=5.00
SPEND_WARNING_THRESHOLD_PCT=80.0

# Slide 2 & 3 - Scoring & Review Lead
FIT_THRESHOLD_SCORE=70
DEFAULT_BID_LEAD_EMAIL="bid.lead@acme-consulting.org"

# Thrivewave SMS Alerts Configuration
# Keep false for local development and tests. Set true only on the server that should send real SMS.
ENABLE_SMS_ALERTS=false
THRIVEWAVE_API_KEY=""
THRIVEWAVE_SENDER_ID="ThriveVas"
THRIVEWAVE_API_URL="https://sms.thrivevas.com/v1/message/send"
THRIVEWAS_MSISDN=""
THRIVEWAS_PASSWORD=""
THRIVEWAS_IDENTITY_API_URL="https://identity.thrivevas.com/v1/auth/api-key/generate"
# Phone that receives bid alerts, e.g. 2547XXXXXXXX. Never commit real credentials.
BID_LEAD_PHONE=""

# AI Reasoning Engine (Choose: mock | claude | gemini | openai)
LLM_PROVIDER="mock"
ANTHROPIC_API_KEY=""
CLAUDE_MODEL="claude-3-5-sonnet-20241022"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-pro"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"

# Email Delivery (Choose: mock | resend | smtp)
EMAIL_PROVIDER="mock"
RESEND_API_KEY=""
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""

# API Security
ADMIN_API_KEY="biddesk-secret-key-2026"
